generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REPUBLIC_EMPLOYEE
  REGIONAL_EMPLOYEE
  // Read-only access to the regions the user is assigned to.
  VIEWER
  // Enters the daily work of one district's employees; linked to that district, not to a region.
  DISTRICT_HEAD
}

enum CallStatus {
  CALLED_SUCCESSFULLY
  NO_ANSWER
  CALLBACK_REQUIRED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  fullName     String
  phone        String?
  passwordHash String
  role         UserRole
  // Set only for district heads.
  districtId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  district          District?                  @relation("DistrictHeads", fields: [districtId], references: [id], onDelete: Restrict)
  regionAssignments EmployeeRegionAssignment[]
  sessions          Session[]

  @@index([role])
  @@index([districtId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Region {
  id                      String   @id @default(cuid())
  name                    String   @unique
  groupLeaderAssignmentId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  districts          District[]
  employeeAssignments EmployeeRegionAssignment[] @relation("RegionEmployees")
  groupLeaderAssignment EmployeeRegionAssignment? @relation("RegionGroupLeader", fields: [groupLeaderAssignmentId, id], references: [id, regionId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([groupLeaderAssignmentId, id])
}

model District {
  id                            String   @id @default(cuid())
  name                          String
  regionId                      String
  engineerCount                 Int?
  xatlovEmployeeCount           Int?
  objectCount                   Int?
  mfyCount                      Int?
  republicEmployeeAssignmentId  String?
  regionalEmployeeAssignmentId  String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)
  republicEmployeeAssignment EmployeeRegionAssignment? @relation("RepublicEmployeeAssignment", fields: [republicEmployeeAssignmentId, regionId], references: [id, regionId], onDelete: Restrict, onUpdate: Cascade)
  regionalEmployeeAssignment EmployeeRegionAssignment? @relation("RegionalEmployeeAssignment", fields: [regionalEmployeeAssignmentId, regionId], references: [id, regionId], onDelete: Restrict, onUpdate: Cascade)
  xatlovRecords XatlovRecord[]
  mkdRecords    MkdRecord[]
  radLimits     RadLimit[]
  overdueSnapshots OverdueSnapshot[]
  callLogs CallLog[]
  heads     User[]             @relation("DistrictHeads")
  employees DistrictEmployee[]

  @@unique([name, regionId])
  @@index([regionId])
  @@index([republicEmployeeAssignmentId, regionId])
  @@index([regionalEmployeeAssignmentId, regionId])
}

model XatlovRecord {
  id                         String   @id @default(cuid())
  districtId                 String
  recordDate                 DateTime @db.Date
  completedMfyCount          Int
  censusCount                Int
  completedObjectCount       Int?
  migrationCount             Int
  paymentDebt                Decimal? @db.Decimal(14, 2)
  completedMfyNames          String[] @default([])
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([districtId, recordDate])
  @@index([recordDate])
}

model MkdRecord {
  id              String   @id @default(cuid())
  districtId      String
  // Daily snapshot: MKD of the given year that are in progress as of recordDate.
  year            Int
  recordDate      DateTime @db.Date
  inProgressCount Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([districtId, year, recordDate])
  @@index([recordDate])
}

model RadLimit {
  id                   String   @id @default(cuid())
  districtId           String
  // Month-to-date snapshot: the limit and rejections of recordDate's month as of that day.
  recordDate           DateTime @db.Date
  monthlyLimit         Int
  rejectedApplications Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([districtId, recordDate])
  @@index([recordDate])
}

model OverdueSnapshot {
  id          String   @id @default(cuid())
  districtId  String
  recordDate  DateTime @db.Date
  stage1to3   Int      @default(0)
  stage4to7   Int      @default(0)
  stage8to14  Int      @default(0)
  stage15to30 Int      @default(0)
  stage31to90 Int      @default(0)
  stage90plus Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([districtId, recordDate])
  @@index([recordDate])
}

model CallLog {
  id                    String     @id @default(cuid())
  districtId            String
  callDate              DateTime   @db.Date
  status                CallStatus
  monitoringAreas       String[]   @default([])
  issues                String?
  nextAction            String?
  followUpDate          DateTime?  @db.Date
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  district District @relation(fields: [districtId], references: [id], onDelete: Restrict)

  @@unique([districtId, callDate])
  @@index([callDate, status])
}

// District staff without system accounts; the list is kept by the Republic employees of the region.
model DistrictEmployee {
  id         String   @id @default(cuid())
  districtId String
  fullName   String
  position   String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district  District            @relation(fields: [districtId], references: [id], onDelete: Restrict)
  dailyWork EmployeeDailyWork[]

  @@index([districtId])
}

// Daily census and migration counts of one district employee.
model EmployeeDailyWork {
  id             String   @id @default(cuid())
  employeeId     String
  recordDate     DateTime @db.Date
  censusCount    Int
  migrationCount Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee DistrictEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, recordDate])
  @@index([recordDate])
}

model EmployeeRegionAssignment {
  id        String   @id @default(cuid())
  userId    String
  regionId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  region Region @relation("RegionEmployees", fields: [regionId], references: [id], onDelete: Restrict)
  leadsRegion Region? @relation("RegionGroupLeader")
  republicDistricts District[] @relation("RepublicEmployeeAssignment")
  regionalDistricts District[] @relation("RegionalEmployeeAssignment")

  @@unique([userId, regionId])
  @@unique([id, regionId])
  @@index([regionId])
}
